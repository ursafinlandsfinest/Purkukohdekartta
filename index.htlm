<!DOCTYPE html>
<html lang="fi">
<head>
  <meta charset="UTF-8" />
  <title>Purkukohteet (OSM)</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <style>
    html, body { height: 100%; margin: 0; }
    #map { height: 100vh; width: 100%; }
  </style>
</head>

<body>
<div id="map"></div>

<script>
  // Kartta (Suomi)
  const map = L.map('map').setView([65.0, 26.0], 5);

  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '&copy; OpenStreetMap'
  }).addTo(map);

  // Overpass API query
  const query = `
  [out:json];
  (
    way["building"="demolished"](60,20,70,32);
    relation["building"="demolished"](60,20,70,32);
  );
  out center;
  `;

  fetch("https://overpass-api.de/api/interpreter", {
    method: "POST",
    body: query
  })
  .then(res => res.json())
  .then(data => {

    data.elements.forEach(el => {
      const lat = el.lat || el.center?.lat;
      const lon = el.lon || el.center?.lon;

      if (!lat || !lon) return;

      L.circleMarker([lat, lon], {
        radius: 6,
        color: "#2c3e50",
        fillColor: "#e74c3c",
        fillOpacity: 0.8
      }).addTo(map)
      .bindPopup("OSM: purkuun merkitty rakennus");
    });

  })
  .catch(err => {
    console.log("Overpass error:", err);
  });
</script>

</body>
</html>
